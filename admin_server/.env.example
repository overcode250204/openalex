# Copy to .env for local dev. On Render/Railway, set these as dashboard
# environment variables instead — do not upload a .env file there.

# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key. Then minify the downloaded JSON to one line, e.g.:
#   node -e "console.log(JSON.stringify(require('./serviceAccountKey.json')))"
# Paste the single-line result below (keep the quotes out of the .env value).
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...", ...}

PORT=8080
